<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.9</version>
        <relativePath/>
    </parent>

    <groupId>com.pocs</groupId>
    <artifactId>s06p03-claude-vs-gemini-rag-quality-poc</artifactId>
    <version>0.1.0</version>
    <name>s06p03-claude-vs-gemini-rag-quality-poc</name>
    <description>RAG quality comparison POC: one identical QuestionAnswerAdvisor + SimpleVectorStore
        pipeline over a fixed knowledge base, swapping only the underlying ChatModel bean between
        AnthropicChatModel and Gemini's GoogleGenAiChatModel, plus a JUnit golden-dataset harness scoring
        groundedness for both providers.</description>

    <properties>
        <java.version>25</java.version>
        <!-- Pinned to 1.1.8, matching s01p02/s04p03/s05p03: spring-ai-google-genai 2.0.1 needs Spring
             Framework 7 (the Boot 4 line) and fails to start on this Boot 3.5.9 parent. -->
        <spring-ai.version>1.1.8</spring-ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- Note: as in s04p03, spring-ai-bom 1.1.8 has no
             "spring-ai-vertex-ai-gemini-spring-boot-starter"/VertexAiGeminiChatModel artifact (the
             roadmap's original wording) - Gemini support in this BOM line ships as
             spring-ai-starter-model-google-genai / GoogleGenAiChatModel / GoogleGenAiChatOptions,
             same as s01p02/s04p03 (see README "Deviations"). -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-anthropic</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-google-genai</artifactId>
        </dependency>
        <!-- SimpleVectorStore itself needs no particular provider - retrieval in this POC runs on the
             in-process DeterministicFakeEmbeddingModel (see main/DeterministicFakeEmbeddingModel), so
             the whole pipeline, including the QuestionAnswerAdvisor retrieval step, works with zero
             embedding API key. Only the generation step needs a real key, and only for the live
             comparison test. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-vector-store</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-advisors-vector-store</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
