<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.9</version>
        <relativePath/>
    </parent>

    <groupId>com.pocs</groupId>
    <artifactId>s06p04-query-transformation-poc</artifactId>
    <version>0.1.0</version>
    <name>s06p04-query-transformation-poc</name>
    <description>Query transformation POC: CompressionQueryTransformer for conversational query condensation,
        RewriteQueryTransformer for retrieval-optimized rewriting, and MultiQueryExpander for query fan-out with
        result deduplication, wired against a SimpleVectorStore.</description>

    <properties>
        <java.version>25</java.version>
        <!-- Pinned to Spring AI 1.1.8, matching every other POC in this repo. -->
        <spring-ai.version>1.1.8</spring-ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- CompressionQueryTransformer, RewriteQueryTransformer, MultiQueryExpander, and the
             DocumentRetriever/DocumentJoiner abstractions used to merge fan-out results all live
             in spring-ai-rag - it needs no vector store or model provider of its own. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-rag</artifactId>
        </dependency>
        <!-- SimpleVectorStore backs the end-to-end retrieval demo, same as s05p03 - zero external
             dependency, provable with a fake EmbeddingModel and zero API keys. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-vector-store</artifactId>
        </dependency>
        <!-- Anthropic ChatModel for the optional live demo/tests only - the default no-key test
             path uses a fake ChatModel (see FakeChatModel), never a real network call. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-anthropic</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
