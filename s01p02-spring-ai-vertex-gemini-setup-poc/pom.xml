<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.9</version>
        <relativePath/>
    </parent>

    <groupId>com.pocs</groupId>
    <artifactId>s01p02-spring-ai-vertex-gemini-setup-poc</artifactId>
    <version>0.1.0</version>
    <name>s01p02-spring-ai-vertex-gemini-setup-poc</name>
    <description>Spring AI + Gemini setup POC: spring-ai-starter-model-google-genai, GoogleGenAiChatModel, ChatClient, and .call().content().</description>

    <properties>
        <java.version>25</java.version>
        <!-- Pinned to Spring AI 1.1.8, NOT 2.0.1 like the Anthropic POCs in this repo.
             spring-ai-google-genai 2.0.1 depends on Spring Framework 7.0.9 (the Boot 4
             line) via spring-context-support, which is incompatible with the Boot 3.5.9
             parent used here (Framework 6.2.x) - it fails at context startup with
             NoClassDefFoundError: org.springframework.core.retry.RetryTemplate, a class
             that doesn't exist before Framework 7. 1.1.8 is the last Spring AI line
             whose google-genai module still targets Framework 6.2.x. -->
        <spring-ai.version>1.1.8</spring-ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-google-genai</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
